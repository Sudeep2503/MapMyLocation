<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_location"
                    app:tint="#2563EB"
                    android:contentDescription="App Logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MapMyLocation"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weather-Based Route &amp; Music Player"
                        android:textSize="12sp"
                        android:textColor="#64748B" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Search Bar Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etDestination"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_search"
                        android:hint="Enter destination (e.g., Paris, New York)"
                        android:textColorHint="#94A3B8"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:imeOptions="actionSearch"
                        android:inputType="textCapWords" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:text="Search"
                        android:textAllCaps="false"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_search"
                        app:backgroundTint="#2563EB" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Interactive Google Map Frame -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.fragment.app.FragmentContainerView
                        android:id="@+id/mapFragment"
                        android:name="com.google.android.gms.maps.SupportMapFragment"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btnMyLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="12dp"
                        android:src="@drawable/ic_location"
                        app:fabSize="mini"
                        app:tint="#2563EB"
                        app:backgroundTint="#FFFFFF"
                        android:contentDescription="Current Location" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Route Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRouteInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ROUTE INFORMATION"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="#2563EB" />

                    <TextView
                        android:id="@+id/tvDestinationTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destination: Not selected"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:layout_marginTop="4dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Distance"
                                android:textSize="12sp"
                                android:textColor="#64748B" />

                            <TextView
                                android:id="@+id/tvDistance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- km"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#0F172A" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Estimated Duration"
                                android:textSize="12sp"
                                android:textColor="#64748B" />

                            <TextView
                                android:id="@+id/tvDuration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- mins"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#0F172A" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Weather Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWeatherInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DESTINATION WEATHER"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="#0284C7" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <ImageView
                            android:id="@+id/ivWeatherIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_weather_sunny"
                            android:contentDescription="Weather Icon" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvTemperature"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- °C"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:textColor="#0F172A" />

                            <TextView
                                android:id="@+id/tvWeatherCondition"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Condition: Unknown"
                                android:textSize="13sp"
                                android:textColor="#475569" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvWeatherDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Humidity: -- % | Wind: -- km/h"
                        android:textSize="12sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Music Recommendation & Player Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMusicPlayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#1E1B4B"
                app:strokeColor="#312E81"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_music_note"
                            app:tint="#A5B4FC"
                            android:contentDescription="Music Icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WEATHER MUSIC PLAYER"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:textColor="#A5B4FC"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMusicCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Category: Select a destination to match music"
                        android:textSize="13sp"
                        android:textColor="#C7D2FE"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvTrackTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Track: No audio playing"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/tvPlaybackStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status: Stopped"
                        android:textSize="12sp"
                        android:textColor="#818CF8"
                        android:layout_marginTop="2dp" />

                    <!-- Media Controls -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginTop="14dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPrev"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            app:icon="@drawable/ic_skip_previous"
                            app:iconTint="#FFFFFF"
                            app:backgroundTint="#312E81" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPlayPause"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            app:icon="@drawable/ic_play"
                            app:iconTint="#1E1B4B"
                            app:backgroundTint="#818CF8" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStop"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="12dp"
                            app:icon="@drawable/ic_stop"
                            app:iconTint="#FFFFFF"
                            app:backgroundTint="#312E81" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNext"
                            style="@style/Widget.Material3.Button.IconButton"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            app:icon="@drawable/ic_skip_next"
                            app:iconTint="#FFFFFF"
                            app:backgroundTint="#312E81" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>